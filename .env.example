# Apple credentials for the iOS release flow. Copy to `.env` and fill in.
# `.env` is gitignored — none of these values belong in the repository.
#
# Where to find them:
#   EXPO_ASC_*        App Store Connect > Users and Access > Integrations > Keys
#                     (the Issuer ID sits above the key table; download the .p8
#                     once and keep it in ~/.appstoreconnect/private_keys/)
#   EXPO_APPLE_TEAM_ID  Apple Developer > Membership, or:
#                     security find-certificate -c "Apple Distribution" -p \
#                       | openssl x509 -noout -subject

EXPO_ASC_API_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
EXPO_ASC_KEY_ID=
EXPO_ASC_ISSUER_ID=
EXPO_APPLE_TEAM_ID=
